{
  "app": {
    "name": "Trading Signal System",
    "version": "7.0",
    "environment": "production",
    "debug": false,
    "timezone": "Asia/Tehran"
  },
  "auto_trainer": {
    "enabled": false,
    "interval_hours": 6,
    "start_hours": [2, 8, 14, 20],
    "coins": ["bitcoin", "ethereum"],
    "period": "1m",
    "incremental": true,
    "min_credits": 100
  },
  "historical_points": {
    "fear_greed": 3,
    "btc_dominance": 3,
    "global_market": 3,
    "chart": 31
  },
  "dashboard": {
    "price_interval": 15,
    "credits_interval": 300,
    "status_interval": 180,
    "fear_greed_interval": 300,
    "btc_dominance_interval": 300,
    "news_interval": 600,
    "alerts_interval": 60
  },
  "cache": {
    "price_ttl": 60,
    "fear_greed_ttl": 300,
    "btc_dominance_ttl": 300,
    "news_ttl": 600,
    "credits_ttl": 300,
    "status_ttl": 180,
    "chart_ttl": 3600
  },
  "model": {
    "version": "1.0",
    "mode": "DEMO",
    "default_period": "1m",
    "auto_train_interval": 6,
    "min_data_points": 30
  },
  "thresholds": {
    "ram_warning": 70,
    "ram_critical": 85,
    "credit_warning": 15,
    "credit_critical": 5,
    "cpu_warning": 70,
    "cpu_critical": 90
  },
  "system": {
    "health_check_interval": 30,
    "metrics_collection": true
  },
  "scheduler": {
    "check_interval": 1,
    "light_interval": 3,
    "medium_interval": 30,
    "heavy_interval": 300
  }
}

{
  "version": "1.0",
  "description": "قوانین پیش‌فرض Rule Engine",
  "updated_at": "2026-09-29",

  "rules": {
    "rsi": {
      "enabled": true,
      "weight": 0.30,
      "min": 25,
      "max": 60,
      "column": "RSI"
    },
    "volume": {
      "enabled": true,
      "weight": 0.20,
      "multiplier": 1.2,
      "column": "Volume",
      "ma_column": "Volume_MA20"
    },
    "trend": {
      "enabled": true,
      "weight": 0.30,
      "ma_column": "MA50",
      "vs_ma": "above",
      "tolerance": 0.0
    },
    "momentum": {
      "enabled": true,
      "weight": 0.20,
      "hist_column": "MACD_hist",
      "macd_positive": null,
      "require_signal_cross": false
    }
  },

  "scoring": {
    "aggregation": "weighted_sum",
    "min_pass_score": 0.55,
    "min_candles": 50
  },

  "state_machine": {
    "watching_threshold": 0.35,
    "setup_threshold": 0.65,
    "cooling_candles": 3,
    "snapshot_ttl": 28800,
    "enable_db_history": true
  },

  "batch": {
    "batch_size": 30,
    "max_concurrent_fetches": 10,
    "max_workers": 4,
    "timeframe": "4h",
    "candle_limit": 100
  },

  "symbols": {
    "mode": "top_volume",
    "count": 30,
    "exclude_stablecoins": true,
    "min_volatility_24h": 0.015
  },

  "indicators": {
    "rsi_period": 14,
    "ma_periods": [50, 200],
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "volume_ma_period": 20,
    "atr_period": 14
  }
}

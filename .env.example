# ============================================================
# .env.example - متغیرهای محیطی پروژه
# ============================================================
# کپی کنید و نام فایل را به .env تغییر دهید
# سپس مقادیر واقعی را جایگزین کنید
# ============================================================

# ============================================================
# 🔐 امنیت و احراز هویت
# ============================================================

# کلید مخفی Flask (تولید کنید با: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================================
# 🌐 API کوین‌استیتس
# ============================================================

# کلید API (از داشبورد coinstats.app دریافت کنید)
COINSTATS_API_KEY=your-coinstats-api-key-here

# ============================================================
# 🗄️ دیتابیس PostgreSQL
# ============================================================

POSTGRES_HOST=your-postgres-host.cloud.layerbase.dev
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=your_database_name
POSTGRES_SSL=true

# ============================================================
# 🗄️ دیتابیس Redis (کش)
# ============================================================

REDIS_HOST=your-redis-host.cloud.layerbase.dev
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true
REDIS_DB=0

# ============================================================
# 🗄️ دیتابیس SQLite / Analytics (از طریق PostgreSQL)
# ============================================================

SQLITE_HOST=your-sqlite-host.cloud.layerbase.dev
SQLITE_PORT=5432
SQLITE_USER=layerbase
SQLITE_PASSWORD=your-sqlite-password
SQLITE_DATABASE=sqlite_001
SQLITE_SSL=true

# ============================================================
# ⚙️ تنظیمات برنامه
# ============================================================

# محیط: production, development, testing
FLASK_ENV=production

# حالت دیباگ (فقط برای توسعه)
FLASK_DEBUG=False

# پورت اجرا
PORT=5000

# منطقه زمانی
TZ=Asia/Tehran

# ============================================================
# 📊 تنظیمات متریک و Scheduler
# ============================================================

# فواصل جمع‌آوری متریک (ثانیه)
METRICS_LIGHT_INTERVAL=3
METRICS_MEDIUM_INTERVAL=30
METRICS_HEAVY_INTERVAL=300

# ============================================================
# 🤖 تنظیمات مدل و آموزش
# ============================================================

# فعال‌سازی آموزش خودکار (true/false)
AUTO_TRAINER_ENABLED=false

# فاصله آموزش خودکار (ساعت)
AUTO_TRAINER_INTERVAL=6

# بازه زمانی پیش‌فرض مدل
MODEL_DEFAULT_PERIOD=1m

# ============================================================
# 📋 تنظیمات لاگ
# ============================================================

# سطح لاگ: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# حداکثر تعداد خطوط لاگ
MAX_LOG_LINES=500

# ============================================================
# 📊 تنظیمات Dashboard
# ============================================================

# بازه به‌روزرسانی داشبورد (میلی‌ثانیه)
DASHBOARD_REFRESH_INTERVAL=30000

# ============================================================
# 🛡️ تنظیمات امنیتی (اختیاری)
# ============================================================

# فعال‌سازی HTTPS اجباری
SESSION_COOKIE_SECURE=true

# مدت زمان نشست (ثانیه)
SESSION_TIMEOUT=86400

# ============================================================
# 🔧 تنظیمات پیشرفته (اختیاری)
# ============================================================

# حداکثر تعداد Retry برای API
API_MAX_RETRIES=3

# زمان تایم‌اوت API (ثانیه)
API_TIMEOUT=15

# تعداد نقاط تاریخی برای آموزش
HISTORICAL_POINTS_FEAR_GREED=3
HISTORICAL_POINTS_BTC_DOMINANCE=3
HISTORICAL_POINTS_GLOBAL_MARKET=3
HISTORICAL_POINTS_CHART=31

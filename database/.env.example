# .env.example
# ============================================================
# کپی کنید و اسمش رو بذارید .env (برای اجرای محلی)
# ============================================================

# Redis Main
REDIS_MAIN_URL=https://chief-buck-93038.upstash.io
REDIS_MAIN_TOKEN=your_token_here

# Redis Secondary (اختیاری)
REDIS_SECONDARY_URL=rediss://default:token@host:6379

# تنظیمات عمومی
DATABASE_DEFAULT=redis_main
CACHE_TTL=3600

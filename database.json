{
    "databases": {
        "redis_main": {
            "type": "redis",
            "protocol": "rest",
            "url": "${REDIS_MAIN_URL}",
            "token": "${REDIS_MAIN_TOKEN}",
            "description": "دیتابیس اصلی - کش و داده‌های موقت",
            "enabled": true
        },
        "redis_secondary": {
            "type": "redis",
            "protocol": "tcp",
            "url": "${REDIS_SECONDARY_URL}",
            "description": "دیتابیس ثانویه - برای آینده",
            "enabled": false
        }
    },
    "default_db": "redis_main",
    "settings": {
        "cache_ttl": 3600,
        "retry_attempts": 3,
        "retry_delay": 1
    }
}
